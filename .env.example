# =================================================================
# CONFIGURATION ET VARIABLES D'ENVIRONNEMENT - GEICG (OLIVE SERVICE)
# =================================================================
# Remarque : Copiez ce fichier vers `.env` et adaptez les valeurs.

# ---- APPLICATION ----
APP_ENV=local
APP_NAME="GEICG - Olive Service"
APP_URL=http://localhost/geicg/
APP_SECRET=e7b415a9f24c3d82a10e64b8592c3017f8d641952e3b1c09847192a543e0618b

# ---- BASE DE DONNÉES ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=olive
DB_USER=admin
DB_PASSWORD=admin

# ---- SERVICES EMAIL (PHPMailer / SMTP LWS) ----
MAIL_MAILER=smtp
# Serveur SMTP LWS (Format: mail.votre-domaine.com ou mail.lws.fr)
MAIL_HOST=mail.votre-domaine.com
# Port LWS : 465 (SSL recommandé) ou 587 (TLS)
MAIL_PORT=465
MAIL_USERNAME=contact@votre-domaine.com
MAIL_PASSWORD=votre_mot_de_passe_mail_lws
# Encryption LWS : ssl (pour port 465) ou tls (pour port 587)
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@votre-domaine.com
MAIL_FROM_NAME="GEICG - Olive Service"

# ---- NOTIFICATIONS PUSH (OneSignal) ----
ONESIGNAL_APP_ID=54d8db10-a446-4542-9b2c-2d49d1433d59
ONESIGNAL_REST_API_KEY=votre_cle_api_onesignal

# ---- AUTHENTIFICATION GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/geicg/auth/google/callback

# ---- EXPÉRIMENTATION / PDF GENERATION (Dompdf / Mpdf) ----
DOMPDF_PAPER_SIZE=A4
DOMPDF_ORIENTATION=portrait
